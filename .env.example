# .env.example — Copia este archivo a .env y rellena los valores

# ============================
# Configuración Base
# ============================
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=finanzas_gatunas
SECRET_KEY=cambia-esto-por-una-clave-segura
PORT=3000

# ============================
# Email (Gmail)
# ============================
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
# Contraseña de aplicación de 16 caracteres (NO tu contraseña de Gmail)
MAIL_PASSWORD=xxxx xxxx xxxx xxxx
MAIL_DEFAULT_SENDER=tu_email@gmail.com

# ============================
# Gemini AI (Google AI Studio)
# Obtén tu clave gratis en: https://aistudio.google.com/app/apikey
# ============================
GEMINI_API_KEY=tu_api_key_de_gemini

# ============================
# Bot de Telegram
# Crea tu bot con @BotFather en Telegram y pega el token aquí.
# Si tienes un dominio público, agrega la URL del webhook.
# En desarrollo local, el webhook no es necesario (el bot responde por polling).
# ============================
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# URL completa del webhook (opcional - si no se configura, el bot no recibirá actualizaciones automáticas)
TELEGRAM_WEBHOOK_URL=https://your-domain.com/telegram/webhook
# Token secreto para verificar la firma del webhook (recomendado en producción)
TELEGRAM_SECRET_TOKEN=your_random_secret_token_here

# ============================
# Zona horaria (para el scheduler)
# ============================
TIMEZONE=America/Mexico_City
